    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"category\": \"배송\",\n  \"sentiment\": \"부정\",\n  \"urgency\": \"상\",\n  \"summary\": \"배송이 지연되어 불만을 제기함\",\n  \"needs_review\": false\n}"
      },
